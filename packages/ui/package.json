{
  "name": "@eco/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared React component library for Eco apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@eco/config": "workspace:*",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://econetwork.ai",
  "bugs": {
    "url": "https://github.com/camsteinberg/eco/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camsteinberg/eco.git",
    "directory": "packages/ui"
  }
}
