# ══════════════════════════════════════════════════════════════
# Eco — Environment Variables
# Copy to .env and fill in values
# ══════════════════════════════════════════════════════════════

# ── Shared ──────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info                    # debug | info | warn | error

# ── API Gateway (apps/api) ─────────────────────────────────
PORT=3001                         # API port
DATABASE_URL=                     # Required: PostgreSQL connection string (Neon)
REDIS_URL=                        # Optional: Redis URL for the health readiness probe + auth rate limiting
API_INTERNAL_URL=http://localhost:3001  # Internal base URL (auth baseURL fallback)
WEB_URL=http://localhost:3000     # CORS origin whitelist

# Auth (Better Auth)
# Session cookies verified against sessions table (Better Auth)
BETTER_AUTH_BASE_URL=             # Optional: override base URL for auth (defaults to API_INTERNAL_URL)

# OAuth Social Login (all optional — providers disabled if client ID not set)
GOOGLE_CLIENT_ID=                 # Google OAuth client ID (Google Cloud Console)
GOOGLE_CLIENT_SECRET=             # Google OAuth client secret
GITHUB_CLIENT_ID=                 # GitHub OAuth app client ID (github.com/settings/developers)
GITHUB_CLIENT_SECRET=             # GitHub OAuth app client secret

# Email (optional — password reset emails disabled if not set)
RESEND_API_KEY=                   # Resend API key for transactional emails (resend.com)

# Sentry (optional — error tracking disabled if not set)
SENTRY_DSN=                       # Sentry DSN for error tracking

# ── Web App (apps/web) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
