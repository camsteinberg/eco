{
  "name": "eco",
  "private": true,
  "version": "0.0.1",
  "description": "Eco — local-first, on-device AI chat",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check:cycles": "node scripts/check-circular-deps.mjs",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "smoke": "pnpm --filter @eco/web test:smoke",
    "qa": "pnpm type-check && pnpm lint && pnpm check:cycles && pnpm build && pnpm smoke && pnpm test",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "eslint-plugin-security": "^4.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "flatted": ">=3.4.0",
      "fast-xml-parser": ">=5.5.6",
      "hono": ">=4.12.27",
      "@hono/node-server": ">=2.0.5",
      "defu": "6.1.5",
      "drizzle-orm": "0.45.2",
      "fast-uri": ">=4.1.2",
      "fast-xml-builder": ">=1.1.7",
      "kysely": ">=0.28.17",
      "next": ">=16.2.11 <17",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": ">=8.5.10",
      "protobufjs": ">=7.5.6",
      "protobufjs@>=8.0.0 <8.6.6": "8.6.6",
      "sharp": ">=0.35.0",
      "js-yaml": ">=4.3.1 <5",
      "vite": "6.4.3",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "form-data@>=4.0.0 <4.0.6": "4.0.6"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-13204",
        "CVE-2025-12735",
        "CVE-2026-47429",
        "CVE-2026-39244"
      ],
      "ignoreGhsas": [
        "GHSA-gv7w-rqvm-qjhr"
      ]
    },
    "patchedDependencies": {
      "@huggingface/transformers@4.2.0": "patches/@huggingface__transformers@4.2.0.patch"
    }
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://econetwork.ai",
  "bugs": {
    "url": "https://github.com/camsteinberg/eco/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camsteinberg/eco.git"
  }
}
