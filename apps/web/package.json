{
  "name": "@eco/web",
  "version": "0.0.1",
  "private": true,
  "description": "Eco consumer web app — Next.js 15",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:validation": "WATCHPACK_POLLING=true NEXT_PUBLIC_ECO_VALIDATION_HARNESS=true next dev --turbopack",
    "build": "node scripts/copy-runtime-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:no-lab-bundle": "node scripts/verify-no-lab-bundled.mjs",
    "seed:evidence": "node scripts/build-seed-evidence.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@eco/ui": "workspace:*",
    "@huggingface/transformers": "4.2.0",
    "@litert-lm/core": "0.13.1",
    "@noble/hashes": "^2.0.1",
    "@sentry/nextjs": "^10.43.0",
    "better-auth": "^1.6.23",
    "driver.js": "^1.4.0",
    "expr-eval": "^2.0.2",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "katex": "^0.16.47",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "strip-markdown": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "unpdf": "^1.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eco/config": "workspace:*",
    "@huggingface/jinja": "0.5.6",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@webgpu/types": "^0.1.69",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "unified": "^11.0.5",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://econetwork.ai",
  "bugs": {
    "url": "https://github.com/camsteinberg/eco/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camsteinberg/eco.git",
    "directory": "apps/web"
  }
}
