# Eco Web App — Environment Variables
# Copy to .env.local and fill in values for local development.

# ── API gateway ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── OAuth providers (optional — buttons hidden unless set to "true") ──────────
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=

# ── Billing UI (optional — hidden by default for free-launch) ────────────────
# Set to "enabled" to show Billing tab, Supporter badges, and pricing UI.
# Default (unset or any other value) = billing surfaces hidden.
NEXT_PUBLIC_ECO_BILLING_UI=

# ── Error tracking (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
