# Eco Web App — Environment Variables
# Copy to .env.local and fill in values for local development.

# ── API gateway ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side upstream for the /v1/* proxy route handler. Optional: it falls
# back to NEXT_PUBLIC_API_URL. Set it only when the proxy should reach the API
# over a different (e.g. private) address than the browser bundle knows about.
API_URL=

# Shared secret sent as X-Eco-Proxy-Key alongside X-Eco-Client-IP so the API can
# rate-limit the real browser client rather than this host's egress IP. MUST
# match API_PROXY_SECRET in the API. Server-only — deliberately NOT
# NEXT_PUBLIC_, it must never reach the browser bundle. Unset → neither header
# is sent and the API keeps its previous behaviour.
API_PROXY_SECRET=

# ── OAuth providers (optional — buttons hidden unless set to "true") ──────────
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=

# ── Service worker (optional) ────────────────────────────────────────────────
# The worker (offline chat shell, static + engine asset caching) registers only
# in a production build, and only when this is "true".
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=
# On a loopback host the worker stays off even then, so a dev build is never
# shadowed by a stale cache. Set this too when running a production build on
# localhost — which is what the acceptance lane does on port 3120.
NEXT_PUBLIC_ENABLE_LOCAL_SW=

# ── Error tracking (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
