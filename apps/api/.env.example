# Eco API Gateway — Environment Variables
# Copy to .env and fill in values for local development.

# ── Database (required for auth) ─────────────────────────────────────────────
# Required in production: if unset, the API refuses to boot (fail closed) so a
# deploy never silently serves an auth-less API. To deliberately run degraded
# without a DB, set ECO_ALLOW_PROD_WITHOUT_DATABASE=true (readiness will report
# the database as missing).
DATABASE_URL=postgresql://user:password@localhost:5432/eco?sslmode=require

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info  # debug | info | warn | error

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_BASE_URL=http://localhost:3001  # public URL of this API

# ── CORS ─────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000  # comma-separated allowed origins

# ── Cache (health readiness probe + rate limiting) ───────────────────────────
# Required in production: backs rate limiting. If unset, the API refuses to boot
# (fail closed) so the auth surface is never silently unprotected. To run without
# rate limiting on purpose, set ECO_ALLOW_UNLIMITED_RATE_LIMITING=true (readiness
# will report rate limiting as missing). Optional outside production.
REDIS_URL=  # redis://default:password@host:port

# ── Web-search relay (optional) ──────────────────────────────────────────────
# Base URL of the SELF-HOSTED SearXNG instance that backs POST /v1/search.
# On Fly it is reachable only over private networking (no public address):
# http://eco-searxng.internal:8080. Config + deploy live in infra/searxng/.
# Unset in development → the route still mounts and answers with an empty result
# set. Unset in production → the route is NOT mounted and the gap is logged at
# error level (the API still boots; search simply does not exist).
# The route also needs REDIS_URL — it will not mount without it, because the
# global daily ceiling below is a Redis counter.
SEARXNG_URL=  # http://eco-searxng.internal:8080

# Max search requests per window per client IP (default 20; its own `search`
# rate-limit tier on top of the general `api` tier).
RATE_LIMIT_SEARCH_MAX=
# GLOBAL ceiling across ALL callers per UTC day (default 5000). Over it, the
# route returns 503 search_unavailable. This bounds the load Eco puts on its own
# search instance; it is not a per-user quota (there are no users on this route).
RATE_LIMIT_SEARCH_DAILY_MAX=
# Per-CALLER ceiling per UTC day (default 300 — roughly 15 live questions an hour
# for a whole day). Well under the global ceiling on purpose: without it the
# per-minute limit above lets one IP drain the whole day's budget in about four
# hours and 503 everyone else. Over it, the route returns 429 rate_limited.
# Both daily counters fail CLOSED: if Redis is unreachable the route answers 503
# rather than relaying unbounded traffic.
RATE_LIMIT_SEARCH_DAILY_PER_IP_MAX=

# ── Email (optional — enables email verification + password reset + magic-link) ──
# When RESEND_API_KEY is set, signup sends a verification email and password
# reset works — but sign-in is NOT gated on verification (soft verification:
# in better-auth 1.4.18 strict gating also suppresses the session at sign-up).
# The sending domain MUST be verified in Resend (DKIM+SPF) or sends fail.
# Leave unset to run email-off (no reset/verify/magic-link).
RESEND_API_KEY=
# "From" address for transactional mail. Defaults to "Eco <noreply@econetwork.ai>".
# Only set this if you verified a different sender domain/address in Resend.
EMAIL_FROM=

# ── OAuth / social sign-in (optional — each provider enables when its creds are set) ──
# Also set NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED / _GITHUB_ENABLED = "true" in the WEB app
# (Vercel) so the buttons render. Currently UNCONFIGURED in prod → email+password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Metrics (optional — bearer token to scrape /metrics; unset = /metrics 404 in prod) ──
METRICS_TOKEN=

# ── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=
